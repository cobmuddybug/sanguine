Screen { background: #07090a; color: #b7d4bf; }

#hud { height: 4; background: #0a100d; border-bottom: heavy #1c2a22; }
.hud-cell { width: 1fr; height: 3; padding: 0 2; margin: 0; }
.hud-cell:hover { background: #12201a; }

#main { height: 1fr; layout: vertical; }
TabbedContent { height: 1fr; width: 1fr; }
TabbedContent > Tabs { background: #0a100d; height: 3; }
Tab { color: #6f8f78; padding: 0 3; }
Tab:hover { color: #33ff66; background: #12201a; }
Tab.-active { color: #33ff66; text-style: bold; }
Underline > .underline--bar { color: #e0243a; background: #1c2a22; }
TabPane { padding: 0; }

#info { height: 9; border: round #1c2a22; border-title-color: #33ff66; padding: 0 2; background: #0a100d; }
.-wide #main { layout: horizontal; }
.-wide #info { width: 52; height: 1fr; }
.-short #info { height: 8; }

#bulk { height: 3; background: #0a100d; }
#bulk-label { width: 8; height: 3; content-align: center middle; text-align: center; color: #6f8f78; text-style: bold; }
.seg { width: 9; height: 3; content-align: center middle; text-align: center; background: #12201a; color: #b7d4bf; margin-right: 1; }
.seg:hover { background: #1c3a2a; color: #33ff66; }
.seg.-active { background: #33ff66; color: #07090a; text-style: bold; }
.spacer { width: 1fr; }
#hire-all { width: 24; height: 3; content-align: center middle; text-align: center; background: #12201a; color: #b7d4bf; }
#hire-all:hover { background: #1c3a2a; color: #33ff66; }
#hire-all.-off { color: #4a5f52; }
#hire-all.-off:hover { background: #12201a; color: #4a5f52; }

#vlist, #plist, #ulist { height: 1fr; scrollbar-size-vertical: 1; scrollbar-color: #1c3a2a; scrollbar-background: #0a100d; }
.vrow { height: 3; border-left: thick #07090a; }
.vrow:hover { background: #12201a; }
.vrow.-selected { border-left: thick #e0243a; background: #0f1a14; }
.vrow.-selected:hover { background: #16261d; }
.vrow.-locked { color: #4a5f52; }
.v-name { width: 1fr; min-width: 26; height: 3; content-align-vertical: middle; }
.v-bar { width: 20; height: 3; margin: 0 1; }
.v-buy { width: 17; height: 3; content-align: center middle; text-align: center; background: #1c3a2a; color: #eafff0; margin-right: 1; }
.v-buy:hover { background: #33ff66; color: #07090a; }
.v-proxy { width: 17; height: 3; content-align: center middle; text-align: center; background: #2a1418; color: #f3c2c8; }
.v-proxy:hover { background: #e0243a; color: #07090a; }
.-off { background: #10171380; color: #4a5f52; }
.v-buy.-off:hover, .v-proxy.-off:hover, .p-btn.-off:hover { background: #101713; color: #4a5f52; }
.-locked .v-buy, .-locked .v-proxy, .-locked .v-bar { display: none; }

.prow { height: 3; }
.prow:hover { background: #12201a; }
.p-name { width: 1fr; height: 3; content-align-vertical: middle; }
.p-btn { width: 20; height: 3; content-align: center middle; text-align: center; background: #2a1418; color: #f3c2c8; margin-right: 1; }
.p-btn:hover { background: #e0243a; color: #07090a; }

#logview { background: #07090a; padding: 0 2; scrollbar-size-vertical: 1; }
#ticker { height: 1; background: #0a100d; padding: 0 2; color: #8fb59b; }

TextModal, ChoiceModal { align: center middle; background: #000000a0; }
#modal { width: 72; max-width: 95%; height: auto; max-height: 90%; background: #0a100d; border: heavy #e0243a; padding: 1 2; }
#modal-title { text-style: bold; color: #33ff66; height: 1; margin-bottom: 1; }
#modal-body { height: auto; max-height: 16; }
#modal-close { height: 3; content-align: center middle; text-align: center; background: #1c3a2a; color: #eafff0; margin-top: 1; }
#modal-close:hover { background: #33ff66; color: #07090a; }

.prow, .urow { border-left: thick #07090a; }
.prow.-selected, .urow.-selected { border-left: thick #e0243a; background: #0f1a14; }
.urow { height: 3; }
.urow:hover { background: #12201a; }
.u-name { width: 1fr; height: 3; content-align-vertical: middle; }
.u-btn { width: 20; height: 3; content-align: center middle; text-align: center; background: #1c3a2a; color: #eafff0; margin-right: 1; }
.u-btn:hover { background: #33ff66; color: #07090a; }
.u-btn.-off:hover { background: #101713; color: #4a5f52; }
#ushop { height: 3; content-align-vertical: middle; background: #0a100d; }
.u-btn.-off { background: #101713; color: #4a5f52; }

#board { height: 1fr; width: 1fr; background: #07090a; }
.choice-btn { height: 4; content-align: left middle; text-align: left; background: #12201a; color: #eafff0; margin-top: 1; padding: 0 2; }
.choice-btn:hover { background: #1c3a2a; }
.choice-btn.-off { background: #0d1210; color: #4a5f52; }
.choice-btn.-off:hover { background: #0d1210; }
#modal.choice { width: 78; }
.hud-cell { padding: 0 1; }
Toast { background: #0a100d; }

#exitbar { height: 4; background: #0a100d; }
#exit-info { width: 1fr; height: 4; content-align-vertical: middle; }
#exit-btn { width: 18; height: 3; margin-top: 0; content-align: center middle; text-align: center; background: #e0243a; color: #07090a; margin-right: 1; }
#exit-btn:hover { background: #ff5a6e; }
#dynbar { height: 4; background: #0a100d; }
#dyn-info { width: 1fr; height: 4; content-align-vertical: middle; }
#dyn-btn { width: 18; height: 3; content-align: center middle; text-align: center; background: #e0243a; color: #07090a; margin-right: 1; }
#dyn-btn:hover { background: #ff5a6e; }
#dyn-btn.-off { background: #2a1418; color: #7a5a60; }
#dyn-btn.-off:hover { background: #2a1418; color: #7a5a60; }
#age-info, #annal-info { height: 4; background: #0a100d; padding: 0 1; content-align-vertical: middle; }
#dynlist, #agelist, #annallist { height: 1fr; scrollbar-size-vertical: 1; }
#exit-btn.-off { background: #2a1418; color: #7a5a60; }
#exit-btn.-off:hover { background: #2a1418; color: #7a5a60; }
#reset-btn { width: 14; height: 3; content-align: center middle; text-align: center; background: #12201a; color: #8fb59b; margin-right: 1; }
#reset-btn:hover { background: #2a1418; color: #f3c2c8; }
#tree { height: 1fr; scrollbar-size-vertical: 1; }
.branch { height: auto; width: 100%; }
.-wide #tree { layout: horizontal; }
.-wide .branch { width: 1fr; margin-right: 1; }
.branch-head { height: 2; padding: 0 1; }
.nrow { height: 3; border-left: thick #07090a; }
.nrow:hover { background: #12201a; }
.nrow.-selected { border-left: thick #e0243a; background: #0f1a14; }
.n-name { width: 1fr; height: 3; content-align-vertical: middle; text-wrap: nowrap; text-overflow: ellipsis; }
.n-btn { width: 14; height: 3; content-align: center middle; text-align: center; background: #1c3a2a; color: #eafff0; }
.n-btn:hover { background: #33ff66; color: #07090a; }
.n-btn.-off { background: #101713; color: #4a5f52; }
.n-btn.-off:hover { background: #101713; color: #4a5f52; }

QuietScreen { background: #000000; align: center middle; }
#quiet { width: auto; height: auto; color: #4a5f52; text-align: center; }
